.DS_Store

# Gold cache and run outputs (regenerate via CLI)
data/gold/*
!data/gold/.gitkeep
data/traces/*
!data/traces/.gitkeep
results/viec1/*
!results/viec1/.gitkeep
results/viec2/*
!results/viec2/.gitkeep
results/viec3/mlx-toy/adapters/
results/viec3/**/sft_data/
*.safetensors

# Raw per-run logs (Giai đoạn 0/5): tens of MB each (5 rounds x 1000 items x
# k=8 solutions), one per Kaggle run — keep on local disk/Drive, not in git.
# Derived summaries (table.md, manifest.json, mechanism.md) still get
# committed as before.
results/viec3/**/generations.jsonl
results/viec3/**/train_logs/
# Raw Kaggle console logs downloaded alongside results (~1MB each, pure
# stdout spam — same rationale as above).
results/viec3/**/notebook*.log

# Repo bundle uploaded to Kaggle as a dataset — build artifact, regenerate
# instead of tracking.
dacntt2026-kaggle.zip
